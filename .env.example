# =============================================================================
# PrivaGen — environment template (.env.example)
# =============================================================================
# Copy to .env.local, fill in REAL values, then ENCRYPT and remove the plaintext:
#
#   cp .env.example .env.local && chmod 600 .env.local
#   $EDITOR .env.local
#   python -m scripts.secrets_manager gen-key            # once, if no key yet
#   python -m scripts.secrets_manager encrypt --in .env.local --out .env.enc
#   shred -u .env.local
#   python -m scripts.secrets_manager check
#
# NEVER commit real secrets. Both .env and .env.local are git-ignored.
# On a rented GPU host, prefer injecting DATASET_ANON_SECRET_KEY at launch (not on disk).
# =============================================================================

# --- Backblaze B2 application keys (least privilege: separate RO + RW keys) ----
# Create two application keys, one per bucket:
#   read-only key   -> B2_READONLY_KEY (+ B2_READONLY_KEY_ID) : SOURCE bucket, read-only
#   read/write key  -> B2_WRITE_KEY    (+ B2_WRITE_KEY_ID)    : DEST bucket, read/write
# Read-only key — restricted to the SOURCE bucket. Ingest (read/copy) ONLY.
B2_READONLY_KEY_ID=your-readonly-key-id
B2_READONLY_KEY=your-readonly-application-key

# Write key — restricted to the DESTINATION bucket. Export (write) ONLY.
B2_WRITE_KEY_ID=your-write-key-id
B2_WRITE_KEY=your-write-application-key

# (Optional legacy fallback: a single shared key ID used for both remotes.
#  Prefer the two separate IDs above for true least privilege.)
# B2_KEY_ID=your-shared-key-id

# --- Buckets and remote paths (non-secret placeholders) ------------------------
# Set these to your own buckets/paths. The pipeline applies the same placeholder
# values if left unset, and refuses a real transfer while they are placeholders.
B2_READONLY_BUCKET=your-source-bucket
B2_WRITE_BUCKET=your-dest-bucket
B2_INGEST_REMOTE_PATH=datasets/raw
B2_EXPORT_REMOTE_PATH=datasets/anonymized

# --- Secrets loader control ---------------------------------------------------
# Fernet key that decrypts .env.enc. SECURITY: inject this at launch (shell/systemd
# EnvironmentFile) rather than baking it into .env.enc itself.
DATASET_ANON_SECRET_KEY=your-fernet-key

# Require the encrypted workflow: 1 = refuse plaintext secret files (.env.local),
# only .env.enc (or platform-injected env) is accepted.
DATASET_ANON_USE_ENCRYPTED_ENV=1

# Refuse group/world-readable secret/key files: 0 = enforce (recommended);
# 1 = allow insecure permissions (NOT recommended).
DATASET_ANON_ALLOW_INSECURE_ENV=0

# --- Startup bucket confirmation ----------------------------------------------
# 1 = on startup, verify read-only ingest + RW output bucket connectivity and
# print the confirmation banner in the terminal / Jupyter UI.
ENABLE_BUCKET_CONFIRMATION=1

# --- rclone -------------------------------------------------------------------
RCLONE_BINARY=rclone
RCLONE_CONFIG=~/.config/rclone/rclone.conf
# RCLONE_AUTO_CONFIRM=0        # set 1 for unattended/CI transfers

# --- Optional: rclone crypt (encrypted export) --------------------------------
# RCLONE_CRYPT_PASSWORD=
# RCLONE_CRYPT_PASSWORD2=
# RCLONE_CRYPT_SALT=

# --- Optional: CrewAI QA LLM (qa.use_crewai_llm: true) ------------------------
# OPENAI_API_KEY=

# --- Optional: GPU / Web UI (4-GPU host => devices 0,1,2,3) -------------------
# CUDA_VISIBLE_DEVICES=0,1,2,3
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
