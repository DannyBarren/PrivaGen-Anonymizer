# Copy to project root as .env (never commit) and source before setup_rclone.sh / pipeline runs.
#
#   cp config/rclone/env.template .env
#   # edit .env with real values
#   set -a && source .env && set +a

B2_KEY_ID=
B2_READONLY_KEY=
B2_WRITE_KEY=
B2_READONLY_BUCKET=
B2_WRITE_BUCKET=

# Optional defaults for CLI flags that omit explicit paths
B2_INGEST_REMOTE_PATH=datasets/raw
B2_EXPORT_REMOTE_PATH=datasets/anonymized
# Aliases supported by load_b2_config:
# B2_SOURCE_BUCKET=  (same as B2_READONLY_BUCKET)
# B2_DEST_BUCKET=      (same as B2_WRITE_BUCKET)
# Unattended real transfers (CI / tests): RCLONE_AUTO_CONFIRM=1

# Optional: override rclone binary or config location
# RCLONE_BINARY=rclone
# RCLONE_CONFIG=~/.config/rclone/rclone.conf
